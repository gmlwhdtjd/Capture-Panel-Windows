<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>CapturePanel</AssemblyName>
    <RootNamespace>CapturePanel.App</RootNamespace>
    <Version>0.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\..\assets\windows\CapturePanel.ico</ApplicationIcon>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\out\dotnet\CapturePanel.App\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\out\dotnet-obj\CapturePanel.App\$(Configuration)\</IntermediateOutputPath>
    <CapturePanelCliPath Condition="'$(CapturePanelCliPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\out\build\windows-x64\bin\$(Configuration)\capture-panel.exe</CapturePanelCliPath>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="$(MSBuildThisFileDirectory)..\..\..\assets\windows\CapturePanel.png"
              Link="Assets\CapturePanel.png" />
    <None Include="$(CapturePanelCliPath)" Link="capture-panel.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(CapturePanelCliPath)')" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\third_party\asio\LICENSE.txt" Link="licenses\Steinberg-ASIO-SDK-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireNativeWorker" BeforeTargets="Build">
    <Error Condition="!Exists('$(CapturePanelCliPath)')" Text="Native worker not found at $(CapturePanelCliPath). Build the C++ targets first." />
  </Target>
</Project>
