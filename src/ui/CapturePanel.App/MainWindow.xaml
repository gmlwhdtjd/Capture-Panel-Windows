<Window x:Class="CapturePanel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Panel"
        Width="600"
        Height="740"
        MinWidth="600"
        MinHeight="740"
        MaxWidth="600"
        MaxHeight="740"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <Border x:Name="StatusCard"
                        Margin="0,0,0,8"
                        Padding="0"
                        CornerRadius="8"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Working">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Ready">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid ClipToBounds="True">
                        <ProgressBar Margin="1"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     IsHitTestVisible="False"
                                     Panel.ZIndex="0"
                                     AutomationProperties.Name="Operation progress">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid ClipToBounds="True">
                                                    <Border x:Name="PART_Track"
                                                            Background="Transparent" />
                                                    <Border x:Name="PART_Indicator"
                                                            HorizontalAlignment="Left"
                                                            CornerRadius="7"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            Opacity="0.14" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProgressVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <Grid Margin="12" Panel.ZIndex="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse x:Name="StatusDot"
                                     Grid.Column="0"
                                     Width="10"
                                     Height="10"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Working">
                                                <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Ready">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding StatusTitle}" />
                                <TextBlock x:Name="StatusMessageRegion"
                                           Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding StatusMessage}"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="{Binding StatusMessage}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Width="32"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    ToolTip="About and licenses"
                                    AutomationProperties.Name="About Capture Panel"
                                    Click="SettingsButton_Click">
                                <TextBlock FontSize="14"
                                           Style="{StaticResource FluentIconStyle}"
                                           Text="&#xE713;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="Source" />
                                <Border x:Name="SourceDisplay"
                                        Height="32"
                                        Padding="8,0"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        ToolTip="{Binding SourcePath}"
                                        AutomationProperties.Name="{Binding SourceName, StringFormat=Selected WAV source: {0}}">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding SourceName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Height="32"
                                    MinWidth="82"
                                    Margin="6,0,0,0"
                                    Padding="10,4"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding ChooseSourceCommand}"
                                    Content="Browse..."
                                    AutomationProperties.Name="Choose WAV source" />
                            <Button Grid.Column="2"
                                    Height="32"
                                    MinWidth="68"
                                    Margin="6,0,0,0"
                                    Padding="10,4"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding TestCommand}"
                                    AutomationProperties.Name="Test capture setup">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ActionIconStyle}" Text="&#xE768;" />
                                    <TextBlock Text="Test" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Height="32"
                                    MinWidth="94"
                                    Margin="6,0,0,0"
                                    Padding="12,4"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource CaptureButtonStyle}"
                                    Command="{Binding CaptureCommand}"
                                    AutomationProperties.Name="{Binding CaptureButtonText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource ActionIconStyle}">
                                                <Setter Property="Text" Value="&#xE7C8;" />
                                                <Setter Property="Foreground" Value="{StaticResource CaptureTextColorBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                        <Setter Property="Text" Value="&#xE711;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                 Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CaptureButtonText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource CaptureTextColorBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                 Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Level" />
                                <TextBlock Text="{Binding LevelText}"
                                           AutomationProperties.Name="{Binding LevelText, StringFormat=Level {0}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LevelState}" Value="Low">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LevelState}" Value="Normal">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LevelState}" Value="Hot">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LevelState}" Value="Clipping">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <StackPanel Grid.Column="2" Margin="12,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Latency" />
                                <TextBlock Style="{StaticResource MetricValueStyle}"
                                           Text="{Binding LatencyText}"
                                           AutomationProperties.Name="{Binding LatencyText, StringFormat=Latency {0}}" />
                            </StackPanel>

                            <Border Grid.Column="3" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <StackPanel Grid.Column="4" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Stability" />
                                <TextBlock Text="{Binding StabilityText}"
                                           AutomationProperties.Name="{Binding StabilityText, StringFormat=Stability {0}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StabilityLevel}" Value="Excellent">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StabilityLevel}" Value="Good">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StabilityLevel}" Value="Caution">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StabilityLevel}" Value="Unstable">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StabilityLevel}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Margin="0,10,0,8"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock x:Name="VerificationRegion"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding VerificationFooterText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="{Binding VerificationFooterText}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="Playback" />
                            <Button Grid.Column="1"
                                    Width="32"
                                    Height="30"
                                    Padding="0"
                                    Command="{Binding RefreshDevicesCommand}"
                                    ToolTip="Refresh ASIO devices"
                                    AutomationProperties.Name="Refresh ASIO devices">
                                <TextBlock FontSize="14"
                                           Style="{StaticResource FluentIconStyle}"
                                           Text="&#xE72C;" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ControlsLocked}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" Style="{StaticResource FieldLabelStyle}" Text="ASIO driver" />
                                <ComboBox Height="32"
                                          ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.Name="Playback ASIO driver">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="IsEnabled" Value="{Binding Available}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Style="{StaticResource FieldLabelStyle}" Text="Output channel" />
                                <ComboBox Height="32"
                                          ItemsSource="{Binding PlaybackChannels}"
                                          SelectedItem="{Binding SelectedPlaybackChannel, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.Name="Playback channel" />
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                        Height="28"
                                        Minimum="-24"
                                        Maximum="0"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding OutputTrimDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Output trim" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding OutputTrimText}" />
                            </Grid>

                            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource MeterStyle}"
                                             Value="{Binding OutputMeterPercent, Mode=OneWay}"
                                             Tag="{Binding OutputMeterState, Mode=OneWay}"
                                             AutomationProperties.Name="Output peak meter" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding OutputPeakText}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recording" />

                        <Grid Margin="0,12,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ControlsLocked}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" Style="{StaticResource FieldLabelStyle}" Text="ASIO driver" />
                                <Border x:Name="RecordingDeviceDisplay"
                                        Height="32"
                                        Padding="8,0"
                                        Background="{DynamicResource ControlFillColorDisabledBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Focusable="False"
                                        ToolTip="ASIO uses one driver for playback and recording."
                                        AutomationProperties.Name="Recording ASIO driver, linked to playback"
                                        AutomationProperties.HelpText="ASIO uses one driver for playback and recording.">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                               Text="{Binding SelectedInputDevice.DisplayName, Mode=OneWay, TargetNullValue=-}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Style="{StaticResource FieldLabelStyle}" Text="Input channel" />
                                <ComboBox Height="32"
                                          ItemsSource="{Binding RecordChannels}"
                                          SelectedItem="{Binding SelectedRecordChannel, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.Name="Recording channel" />
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                        Height="28"
                                        Minimum="-18"
                                        Maximum="12"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding InputTrimDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Input trim" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding InputTrimText}" />
                            </Grid>

                            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource MeterStyle}"
                                             Value="{Binding InputMeterPercent, Mode=OneWay}"
                                             Tag="{Binding InputMeterState, Mode=OneWay}"
                                             AutomationProperties.Name="Input peak meter" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding InputPeakText}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
